      },
      {
        "name": "物品系统",
        "enabled": true,
        "package": "item",
        "files": [
          "ModItems.java"
        ],
        "test_methods": []
      },
      {
        "name": "客户端处理",
        "enabled": true,
        "package": "client",
        "files": [
          "ClientHandlers.java"
        ],
        "test_methods": []
      }
    ],
    
    "ui_elements": [],
    "entities": []
  },
  
  "test_config": {
    "build_command": "./gradlew build --no-daemon -x test",
    "run_command": "./gradlew runClient --no-daemon",
    "refresh_deps_command": "./gradlew --refresh-dependencies",
    "clean_command": "./gradlew clean",
    
    "windows_build_command": ".\\gradlew.bat build --no-daemon -x test",
    "windows_run_command": ".\\gradlew.bat runClient --no-daemon",
    
    "skip_tests": ["test"],
    "timeout_seconds": 300

  "patchouli.evolutionary_mod.page.quickstart.1": "$(l)按键$()$(br)$(li)$(l)K$()：打开饰品装备界面（服务器容器）$(li)$(l)J$()：打开玩家属性面板（客户端）$(br2)饰品主要通过$(l)怪物掉落$()与$(l)箱子$()获得。",
  "patchouli.evolutionary_mod.page.quickstart.2": "$(l)核心成长线$()$(br)饰品槽位 → 品阶 → 随机词条 → 套装效果。$(br2)先把基础槽位填满，再追求更高品阶与套装。",
  "patchouli.evolutionary_mod.page.gameplay_loop.1": "1. 探索、刷怪、开箱，收集饰品。$(br)2. 用 $(l)K$() 装备到对应槽位。$(br)3. 提升品阶与词条，增强战斗力。$(br)4. 凑齐套装触发质变效果。$(br)5. 挑战精英怪，获取更高价值掉落。",
  "patchouli.evolutionary_mod.page.slots.1": "每个玩家共 $(l)18$() 个饰品槽：$(br)$(li)头饰 1$(li)耳环 2$(li)项链 1$(li)手套 2$(li)手镯 2$(li)戒指 4$(li)腰带 1$(li)靴饰 2$(li)配饰 3",
  "patchouli.evolutionary_mod.page.rarity.1": "$(l)品阶$()：残破 / 普通 / 优秀 / 精良 / 史诗 / 传说 / 至臻。$(br2)$(l)掉落池$()：普通怪物池、精英怪物池。$(br)精英池通常更容易出高价值饰品（仍取决于权重配置）。",
  "patchouli.evolutionary_mod.page.attributes.1": "饰品带有随机词条区间。$(br2)已落地战斗系统：$(li)暴击$(li)伤害减免$(li)护甲穿透$(br2)用 $(l)J$() 打开属性面板判断收益。",
  "patchouli.evolutionary_mod.page.sets.1": "穿戴同套装足够件数可激活套装效果。$(br2)当前已实装示例：$(l)龙套$()（2/4/6 件效果不同）。$(br)收集龙族部件并装备即可触发。",
  "patchouli.evolutionary_mod.page.elites.1": "模组加入了多种原版变种精英怪，并配置了饰品战利品与生成。$(br2)建议：先用普通掉落成型，再主动寻找精英怪提升品质。",
  "patchouli.evolutionary_mod.page.chests.1": "原版结构箱子也可能生成饰品。$(br2)跑地牢、要塞、遗迹时记得开箱——前中期成型很快。",
  "patchouli.evolutionary_mod.page.weight.1": "负重会限制你能携带的物品量。$(br2)$(li)基础上限约 120（可配置）$(li)等级加成：每级 +2$(li)安全阈值约 60%：开始减速$(li)警戒阈值约 85%：饱食消耗加快",
  "patchouli.evolutionary_mod.page.weight.2": "超重时移速下降（最高约 50%），超载时饱食消耗最高约 2 倍。$(br2)后续可能加入背包等提升上限的方式。",
  "patchouli.evolutionary_mod.page.forge_table.1": "锻造台用于处理装备的成长与回收。$(br2)它把材料系统拆成四类操作：$(li)强化$(li)属性精华$(li)重锻$(li)粉碎",
  "patchouli.evolutionary_mod.page.forge_table.2": "强化需要 1 个类型精华和 1~10 个同种品阶碎片。$(br2)每次成功强化都会提升 1 阶；属性精华添加也会占用 1 次强化次数。",
  "patchouli.evolutionary_mod.page.forge_table.3": "普通重锻只重滚基础词条并保留强化层；高级重锻会连同强化数值一起重滚，但会偏向更高结果。$(br2)锁定石最多同时锁 2 条词条。",
  "patchouli.evolutionary_mod.page.forge_table.4": "粉碎会销毁装备，但返还已消耗材料：品阶碎片约 50% 回流，类型精华按每份 25% 独立概率回流。$(br2)重锻石不返还。",
  "patchouli.evolutionary_mod.page.materials.1": "材料分为三大主类：$(li)类型精华$(li)品阶碎片$(li)重锻石$(br2)其中品阶碎片与饰品品阶完全对齐，用来决定强化成功率。",
  "patchouli.evolutionary_mod.page.materials.2": "属性精华用于给没有该属性的装备追加一个基础词条。$(br2)它不会额外占用词条槽，但会计入强化次数上限。",
  "patchouli.evolutionary_mod.page.controls.1": "$(l)K$() 饰品界面：实际装备/更换。$(br)$(l)J$() 属性面板：查看数值。$(br2)饰品 Tooltip 边框会按品阶着色。",
  "patchouli.evolutionary_mod.page.troubleshooting.1": "$(l)按了 K 没反应？$()$(br)检查是否在聊天框，或按键设置里 $(l)key.categories.evolutionary_mod$() 是否冲突。$(br2)$(l)不知道该不该换饰品？$()$(br)用 J 看属性变化后再决定。",

